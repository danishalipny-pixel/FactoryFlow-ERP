datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. TENANT, ORGANIZATION & HR
// ----------------------------------------------------

model Company {
  id                    String        @id @default(uuid())
  nameAr                String
  nameEn                String
  commercialRegNo       String?       // السجل التجاري
  taxRegistrationNo     String?       // البطاقة الضريبية
  vatRegistrationNo     String?       // رقم تسجيل ضريبة القيمة المضافة
  etaIssuerId           String?       // كود الشركة في منظومة الضرائب المصرية
  address               String?
  city                  String?       // e.g. العاشر من رمضان، القاهرة
  country               String        @default("Egypt")
  phone                 String?
  email                 String?
  currency              String        @default("EGP")
  defaultVatRate        Float         @default(14.0) // Egyptian Standard VAT
  defaultWhtRate        Float         @default(1.0)  // Egyptian Standard Withholding Tax
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  factories             Factory[]
  departments           Department[]
  users                 User[]
}

model Factory {
  id                    String        @id @default(uuid())
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                  String        @unique
  nameAr                String
  nameEn                String
  location              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  warehouses            Warehouse[]
  workCenters           WorkCenter[]
  productionOrders      ProductionOrder[]
}

model Department {
  id                    String        @id @default(uuid())
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                  String
  nameAr                String
  nameEn                String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  employees             Employee[]
  workCenters           WorkCenter[]
}

model Employee {
  id                    String        @id @default(uuid())
  code                  String        @unique
  nationalId            String?       // الرقم القومي
  firstNameAr           String
  lastNameAr            String
  firstNameEn           String
  lastNameEn            String
  jobTitleAr            String
  jobTitleEn            String
  departmentId          String
  department            Department    @relation(fields: [departmentId], references: [id])
  shift                 String        @default("MORNING") // MORNING, EVENING, NIGHT
  hourlyRateEgp         Float         @default(65.0)
  phone                 String?
  status                String        @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  hireDate              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  assignedOperations    ProductionOperation[]
  attendances           Attendance[]
  inspections           QualityInspection[]
}

model Attendance {
  id                    String        @id @default(uuid())
  employeeId            String
  employee              Employee      @relation(fields: [employeeId], references: [id])
  date                  DateTime
  checkIn               DateTime?
  checkOut              DateTime?
  hoursWorked           Float         @default(8.0)
  status                String        @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE
  createdAt             DateTime      @default(now())
}

// ----------------------------------------------------
// 2. AUTHENTICATION & ACCESS CONTROL
// ----------------------------------------------------

model User {
  id                    String        @id @default(uuid())
  companyId             String?
  company               Company?      @relation(fields: [companyId], references: [id])
  email                 String        @unique
  passwordHash          String
  fullNameAr            String
  fullNameEn            String
  role                  String        @default("PRODUCTION_OPERATOR")
  // Roles: SUPER_ADMIN, FACTORY_OWNER, GENERAL_MANAGER, SALES_MANAGER, PRODUCTION_MANAGER,
  //        PROCUREMENT_MANAGER, WAREHOUSE_MANAGER, ACCOUNTANT, HR_MANAGER, QUALITY_INSPECTOR, PRODUCTION_OPERATOR
  isActive              Boolean       @default(true)
  languagePreference    String        @default("ar") // 'ar' or 'en'
  lastLogin             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  auditLogs             AuditLog[]
  notifications         Notification[]
}

model AuditLog {
  id                    String        @id @default(uuid())
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  action                String        // CREATE, UPDATE, DELETE, APPROVE, CONFIRM, ISSUE, POST
  entity                String        // SalesOrder, ProductionOrder, Invoice, etc.
  entityId              String
  details               String?       // JSON or description
  ipAddress             String?
  createdAt             DateTime      @default(now())
}

model Notification {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  titleAr               String
  titleEn               String
  messageAr             String
  messageEn             String
  type                  String        @default("INFO") // INFO, WARNING, SUCCESS, URGENT
  isRead                Boolean       @default(false)
  link                  String?
  createdAt             DateTime      @default(now())
}

// ----------------------------------------------------
// 3. CRM & SALES (MTO SOURCE)
// ----------------------------------------------------

model Customer {
  id                    String        @id @default(uuid())
  code                  String        @unique
  nameAr                String
  nameEn                String
  taxRegistrationNo     String?       // البطاقة الضريبية
  commercialRegNo       String?       // السجل التجاري
  contactPerson         String?
  email                 String?
  phone                 String?
  address               String?
  city                  String?       @default("القاهرة")
  governorate           String?       @default("القاهرة")
  paymentTermsDays      Int           @default(30)
  creditLimitEgp        Float         @default(500000.0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  quotations            Quotation[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
}

model Quotation {
  id                    String        @id @default(uuid())
  quoteNumber           String        @unique
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id])
  issueDate             DateTime      @default(now())
  validUntil            DateTime
  status                String        @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  subtotalEgp           Float         @default(0.0)
  taxRatePercent        Float         @default(14.0)
  taxAmountEgp          Float         @default(0.0)
  totalAmountEgp        Float         @default(0.0)
  estimatedDeliveryWeeks Int          @default(3)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 QuotationItem[]
  salesOrders           SalesOrder[]
}

model QuotationItem {
  id                    String        @id @default(uuid())
  quotationId           String
  quotation             Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id])
  quantity              Float
  unitPriceEgp          Float
  estimatedCostEgp      Float         @default(0.0)
  marginPercent         Float         @default(25.0)
  totalPriceEgp         Float
  notes                 String?
}

model SalesOrder {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique // e.g. SO-2026-001
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id])
  quotationId           String?
  quotation             Quotation?    @relation(fields: [quotationId], references: [id])
  orderDate             DateTime      @default(now())
  deliveryDeadline      DateTime
  status                String        @default("CONFIRMED")
  // Status: DRAFT, CONFIRMED, IN_PRODUCTION, COMPLETED, DELIVERED, CANCELLED
  subtotalEgp           Float         @default(0.0)
  taxRatePercent        Float         @default(14.0)
  taxAmountEgp          Float         @default(0.0)
  whtRatePercent        Float         @default(1.0)
  whtAmountEgp          Float         @default(0.0)
  totalAmountEgp        Float         @default(0.0)
  advancePaymentEgp     Float         @default(0.0)
  paymentTerms          String?       @default("50% دفعة مقدمة والباقي عند الاستلام")
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 SalesOrderItem[]
  productionOrders      ProductionOrder[]
  materialReservations  MaterialReservation[]
  purchaseRequests      PurchaseRequest[]
  invoices              Invoice[]
}

model SalesOrderItem {
  id                    String        @id @default(uuid())
  salesOrderId          String
  salesOrder            SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id])
  quantity              Float
  unitPriceEgp          Float
  totalPriceEgp         Float
  deliveryDate          DateTime
  customSpecs           String?       // مواصفات تصنيع خاصة حسب رغبة العميل

  productionOrders      ProductionOrder[]
}

// ----------------------------------------------------
// 4. PRODUCT & ENGINEERING (BOM & ROUTING)
// ----------------------------------------------------

model Product {
  id                    String        @id @default(uuid())
  itemCode              String        @unique
  nameAr                String
  nameEn                String
  description           String?
  category              String        // RAW_MATERIAL, SUB_ASSEMBLY, FINISHED_PRODUCT, CONSUMABLE
  unit                  String        // KG, METER, PIECE, SHEET, TON
  standardCostEgp       Float         @default(0.0)
  sellingPriceEgp       Float         @default(0.0)
  drawingNumber         String?       // رقم الرسم الهندسي
  revision              String        @default("Rev.01")
  isActive              Boolean       @default(true)
  safetyStock           Float         @default(0.0) // For raw materials only
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  bom                   BOM?          @relation("ProductBOM")
  usedInBomItems        BOMItem[]     @relation("ComponentRelation")
  routing               Routing?
  quotationItems        QuotationItem[]
  salesOrderItems       SalesOrderItem[]
  productionOrders      ProductionOrder[]
  inventoryItems        Inventory[]
  stockMovements        StockMovement[]
  materialReservations  MaterialReservation[]
  purchaseRequestItems  PurchaseRequestItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  invoiceItems          InvoiceItem[]
  qualityInspections    QualityInspection[]
  materialRequirements  MaterialRequirement[]
}

model BOM {
  id                    String        @id @default(uuid())
  productId             String        @unique
  product               Product       @relation("ProductBOM", fields: [productId], references: [id], onDelete: Cascade)
  version               String        @default("1.0")
  nameAr                String
  nameEn                String
  yieldPercent          Float         @default(100.0)
  estimatedMaterialCost Float         @default(0.0)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 BOMItem[]
}

model BOMItem {
  id                    String        @id @default(uuid())
  bomId                 String
  bom                   BOM           @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentId           String
  component             Product       @relation("ComponentRelation", fields: [componentId], references: [id])
  quantity              Float         // الكمية المطلوبة لإنتاج وحدة واحدة
  unit                  String
  scrapPercentage       Float         @default(2.0) // نسبة الهالك الطبيعي
  notes                 String?
}

model WorkCenter {
  id                    String        @id @default(uuid())
  factoryId             String
  factory               Factory       @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  departmentId          String?
  department            Department?   @relation(fields: [departmentId], references: [id])
  code                  String        @unique
  nameAr                String
  nameEn                String
  capacityHoursPerDay   Float         @default(16.0) // 2 shifts x 8h
  hourlyCostRateEgp     Float         @default(120.0) // تكلفة تشغيل الماكينة لكل ساعة
  efficiencyPercent     Float         @default(90.0)
  status                String        @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, IDLE
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  routingOperations     RoutingOperation[]
  productionOperations  ProductionOperation[]
}

model Routing {
  id                    String        @id @default(uuid())
  productId             String        @unique
  product               Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameAr                String
  nameEn                String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  operations            RoutingOperation[]
}

model RoutingOperation {
  id                    String        @id @default(uuid())
  routingId             String
  routing               Routing       @relation(fields: [routingId], references: [id], onDelete: Cascade)
  sequenceOrder         Int           // 10, 20, 30...
  nameAr                String
  nameEn                String
  workCenterId          String
  workCenter            WorkCenter    @relation(fields: [workCenterId], references: [id])
  setupTimeMinutes      Float         @default(30.0)
  runTimeMinutesPerUnit Float         @default(15.0)
  laborCountRequired    Int           @default(1)
  description           String?
}

// ----------------------------------------------------
// 5. PRODUCTION MANAGEMENT & MTO JOB CARDS
// ----------------------------------------------------

model ProductionOrder {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique // e.g. PO-MTO-2026-001
  salesOrderId          String        // Core MTO trace to confirmed customer order!
  salesOrder            SalesOrder    @relation(fields: [salesOrderId], references: [id])
  salesOrderItemId      String?
  salesOrderItem        SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  factoryId             String
  factory               Factory       @relation(fields: [factoryId], references: [id])
  productId             String
  product               Product       @relation(fields: [productId], references: [id])
  plannedQuantity       Float
  completedQuantity     Float         @default(0.0)
  scrappedQuantity      Float         @default(0.0)
  status                String        @default("RELEASED")
  // Status: DRAFT, RELEASED, IN_PROGRESS, QC_INSPECTION, COMPLETED, CANCELLED
  priority              String        @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  plannedStartDate      DateTime
  plannedDueDate        DateTime
  actualStartDate       DateTime?
  actualCompletionDate  DateTime?

  // Planned Costing vs Actual Costing
  plannedMaterialCostEgp Float        @default(0.0)
  actualMaterialCostEgp  Float        @default(0.0)
  plannedLaborCostEgp    Float        @default(0.0)
  actualLaborCostEgp     Float        @default(0.0)
  plannedOverheadCostEgp Float        @default(0.0)
  actualOverheadCostEgp  Float        @default(0.0)
  totalActualCostEgp     Float        @default(0.0)

  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  operations            ProductionOperation[]
  materialRequirements  MaterialRequirement[]
  materialReservations  MaterialReservation[]
  qualityInspections    QualityInspection[]
}

model ProductionOperation {
  id                    String          @id @default(uuid())
  productionOrderId     String
  productionOrder       ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  sequenceOrder         Int
  operationNameAr       String
  operationNameEn       String
  workCenterId          String
  workCenter            WorkCenter      @relation(fields: [workCenterId], references: [id])
  assignedEmployeeId    String?
  assignedEmployee      Employee?       @relation(fields: [assignedEmployeeId], references: [id])
  status                String          @default("PENDING")
  // Status: PENDING, IN_PROGRESS, PAUSED, COMPLETED
  plannedHours          Float           @default(1.0)
  actualHours           Float           @default(0.0)
  goodQuantity          Float           @default(0.0)
  scrapQuantity         Float           @default(0.0)
  startTime             DateTime?
  endTime               DateTime?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model MaterialRequirement {
  id                    String          @id @default(uuid())
  productionOrderId     String
  productionOrder       ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  materialProductId     String
  materialProduct       Product         @relation(fields: [materialProductId], references: [id])
  requiredQuantity      Float
  reservedQuantity      Float           @default(0.0)
  issuedQuantity        Float           @default(0.0)
  shortageQuantity      Float           @default(0.0)
  unitCostEgp           Float           @default(0.0)
  totalCostEgp          Float           @default(0.0)
  status                String          @default("RESERVED") // PENDING, RESERVED, ISSUED, SHORTAGE
}

// ----------------------------------------------------
// 6. INVENTORY & MTO RESERVATIONS
// ----------------------------------------------------

model Warehouse {
  id                    String        @id @default(uuid())
  factoryId             String
  factory               Factory       @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  code                  String        @unique
  nameAr                String
  nameEn                String
  location              String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  inventoryItems        Inventory[]
  stockMovements        StockMovement[]
  goodsReceipts         GoodsReceipt[]
}

model Inventory {
  id                    String        @id @default(uuid())
  warehouseId           String
  warehouse             Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand        Float         @default(0.0)
  quantityReserved      Float         @default(0.0) // Reserved specifically for MTO Sales/Prod orders
  quantityAvailable     Float         @default(0.0) // = quantityOnHand - quantityReserved
  averageUnitCostEgp    Float         @default(0.0)
  locationBin           String?
  lastCountDate         DateTime?
  updatedAt             DateTime      @updatedAt

  @@unique([warehouseId, productId])
}

model MaterialReservation {
  id                    String          @id @default(uuid())
  salesOrderId          String          // MTO strictly allocated to customer order
  salesOrder            SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productionOrderId     String?
  productionOrder       ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  materialProductId     String
  materialProduct       Product         @relation(fields: [materialProductId], references: [id])
  quantityReserved      Float
  status                String          @default("ACTIVE") // ACTIVE, CONSUMED, CANCELLED
  reservedAt            DateTime        @default(now())
}

model StockMovement {
  id                    String        @id @default(uuid())
  movementNumber        String        @unique
  warehouseId           String
  warehouse             Warehouse     @relation(fields: [warehouseId], references: [id])
  productId             String
  product               Product       @relation(fields: [productId], references: [id])
  movementType          String        // PO_RECEIPT, PROD_ISSUE, PROD_RETURN, ADJUSTMENT, SCRAP
  quantity              Float         // Positive for increase, negative for issue
  unitCostEgp           Float         @default(0.0)
  totalCostEgp          Float         @default(0.0)
  referenceType         String?       // SalesOrder, ProductionOrder, PurchaseOrder
  referenceId           String?
  batchLotNumber        String?
  performedBy           String?
  notes                 String?
  createdAt             DateTime      @default(now())
}

// ----------------------------------------------------
// 7. PROCUREMENT & SHORTAGE ENGINE
// ----------------------------------------------------

model Supplier {
  id                    String        @id @default(uuid())
  code                  String        @unique
  nameAr                String
  nameEn                String
  taxRegistrationNo     String?       // البطاقة الضريبية للمورد
  commercialRegNo       String?       // السجل التجاري
  contactPerson         String?
  email                 String?
  phone                 String?
  address               String?
  category              String?       // METALS, CHEMICALS, FASTENERS, ELECTRICAL
  paymentTermsDays      Int           @default(30)
  rating                Float         @default(4.5)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
}

model PurchaseRequest {
  id                    String        @id @default(uuid())
  requestNumber         String        @unique // e.g. PR-MTO-2026-001
  salesOrderId          String?       // MTO Traceability: Request generated for shortage in order
  salesOrder            SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  requestDate           DateTime      @default(now())
  requiredDate          DateTime
  status                String        @default("PENDING") // PENDING, APPROVED, REJECTED, ORDERED
  priority              String        @default("HIGH")    // LOW, MEDIUM, HIGH, URGENT
  reason                String?       // سبب الطلب (عجز خامات لأمر تشغيل العميل)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 PurchaseRequestItem[]
}

model PurchaseRequestItem {
  id                    String          @id @default(uuid())
  purchaseRequestId     String
  purchaseRequest       PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId             String
  product               Product         @relation(fields: [productId], references: [id])
  quantity              Float
  estimatedUnitCostEgp  Float           @default(0.0)
  totalEstimatedEgp     Float           @default(0.0)
  notes                 String?
}

model PurchaseOrder {
  id                    String        @id @default(uuid())
  poNumber              String        @unique // e.g. PO-2026-001
  supplierId            String
  supplier              Supplier      @relation(fields: [supplierId], references: [id])
  orderDate             DateTime      @default(now())
  expectedDeliveryDate  DateTime
  status                String        @default("CONFIRMED")
  // Status: DRAFT, CONFIRMED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  subtotalEgp           Float         @default(0.0)
  vatRatePercent        Float         @default(14.0)
  vatAmountEgp          Float         @default(0.0)
  whtRatePercent        Float         @default(1.0)
  whtAmountEgp          Float         @default(0.0)
  totalAmountEgp        Float         @default(0.0)
  paymentTerms          String?       @default("سداد خلال 30 يوم من تاريخ الفاتورة")
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 PurchaseOrderItem[]
  goodsReceipts         GoodsReceipt[]
}

model PurchaseOrderItem {
  id                    String        @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id])
  quantity              Float
  unitPriceEgp          Float
  totalPriceEgp         Float
  quantityReceived      Float         @default(0.0)

  goodsReceiptItems     GoodsReceiptItem[]
}

model GoodsReceipt {
  id                    String        @id @default(uuid())
  receiptNumber         String        @unique // e.g. GR-2026-001
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId            String
  supplier              Supplier      @relation(fields: [supplierId], references: [id])
  warehouseId           String
  warehouse             Warehouse     @relation(fields: [warehouseId], references: [id])
  receiptDate           DateTime      @default(now())
  supplierDeliveryNote  String?       // إذن توريد المورد
  receivedBy            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id                    String            @id @default(uuid())
  goodsReceiptId        String
  goodsReceipt          GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId   String
  purchaseOrderItem     PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  quantityReceived      Float
  lotBatchNumber        String?
  qualityStatus         String            @default("ACCEPTED") // PENDING_INSPECTION, ACCEPTED, REJECTED
}

// ----------------------------------------------------
// 8. QUALITY CONTROL
// ----------------------------------------------------

model QualityInspection {
  id                    String          @id @default(uuid())
  inspectionNumber      String          @unique // e.g. QC-2026-001
  type                  String          // INCOMING_MATERIAL, IN_PROCESS, FINAL_PRODUCT
  referenceType         String          // ProductionOrder, GoodsReceipt
  referenceId           String
  productionOrderId     String?
  productionOrder       ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  productId             String
  product               Product         @relation(fields: [productId], references: [id])
  inspectorId           String?
  inspector             Employee?       @relation(fields: [inspectorId], references: [id])
  inspectedQuantity     Float
  passedQuantity        Float
  rejectedQuantity      Float           @default(0.0)
  result                String          @default("PASSED") // PASSED, REJECTED, REWORK_REQUIRED
  inspectionDate        DateTime        @default(now())
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  defects               QualityDefect[]
}

model QualityDefect {
  id                    String            @id @default(uuid())
  qualityInspectionId   String
  qualityInspection     QualityInspection @relation(fields: [qualityInspectionId], references: [id], onDelete: Cascade)
  defectCode            String            // e.g. DEF-DIMENSION, DEF-WELDING, DEF-COATING
  descriptionAr         String
  descriptionEn         String
  severity              String            @default("MINOR") // CRITICAL, MAJOR, MINOR
  quantityAffected      Float             @default(1.0)
  actionTaken           String?           // SCRAP, REWORK, CONCESSION
}

// ----------------------------------------------------
// 9. FINANCE, COSTING & ETA E-INVOICING
// ----------------------------------------------------

model Invoice {
  id                    String        @id @default(uuid())
  invoiceNumber         String        @unique // e.g. INV-2026-001
  etaUuid               String?       // المعرف الفريد لمنظومة الفاتورة الإلكترونية المصرية
  etaSubmissionStatus   String        @default("NOT_SUBMITTED") // NOT_SUBMITTED, Valid, Invalid, Rejected
  salesOrderId          String?
  salesOrder            SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id])
  issueDate             DateTime      @default(now())
  dueDate               DateTime
  subtotalEgp           Float         @default(0.0)
  vatRatePercent        Float         @default(14.0)
  vatAmountEgp          Float         @default(0.0)
  whtRatePercent        Float         @default(1.0)
  whtAmountEgp          Float         @default(0.0)
  totalAmountEgp        Float         @default(0.0)
  paidAmountEgp         Float         @default(0.0)
  paymentStatus         String        @default("UNPAID") // UNPAID, PARTIAL, PAID
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 InvoiceItem[]
  payments              Payment[]
}

model InvoiceItem {
  id                    String        @id @default(uuid())
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId             String
  product               Product       @relation(fields: [productId], references: [id])
  description           String?
  quantity              Float
  unitPriceEgp          Float
  totalPriceEgp         Float
  taxAmountEgp          Float         @default(0.0)
}

model Payment {
  id                    String        @id @default(uuid())
  paymentNumber         String        @unique
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountEgp             Float
  paymentDate           DateTime      @default(now())
  paymentMethod         String        @default("BANK_TRANSFER") // BANK_TRANSFER, CHEQUE, CASH
  referenceNumber       String?       // رقم التحويل البنكي أو الشيك
  bankName              String?       // البنك الأهلي المصري، CIB، بنك مصر
  notes                 String?
  createdAt             DateTime      @default(now())
}

model Expense {
  id                    String        @id @default(uuid())
  expenseNumber         String        @unique
  category              String        // UTILITIES, FACTORY_RENT, MAINTENANCE, SPARE_PARTS, SALARIES, TRANSPORT
  descriptionAr         String
  descriptionEn         String
  amountEgp             Float
  expenseDate           DateTime      @default(now())
  paidTo                String?
  receiptNumber         String?
  createdAt             DateTime      @default(now())
}

model ChartOfAccount {
  id                    String        @id @default(uuid())
  accountCode           String        @unique // e.g. 1010, 2010, 4010, 5010
  nameAr                String
  nameEn                String
  accountType           String        // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  balanceEgp            Float         @default(0.0)
  createdAt             DateTime      @default(now())

  journalLines          JournalEntryLine[]
}

model JournalEntry {
  id                    String        @id @default(uuid())
  entryNumber           String        @unique
  entryDate             DateTime      @default(now())
  descriptionAr         String
  descriptionEn         String
  referenceType         String?       // Invoice, Payment, ProductionCost, Expense
  referenceId           String?
  totalDebitEgp         Float
  totalCreditEgp        Float
  status                String        @default("POSTED") // DRAFT, POSTED
  createdAt             DateTime      @default(now())

  lines                 JournalEntryLine[]
}

model JournalEntryLine {
  id                    String          @id @default(uuid())
  journalEntryId        String
  journalEntry          JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId             String
  account               ChartOfAccount  @relation(fields: [accountId], references: [id])
  debitEgp              Float           @default(0.0)
  creditEgp             Float           @default(0.0)
  notes                 String?
}
