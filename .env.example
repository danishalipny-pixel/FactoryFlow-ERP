# ==============================================================================
# FACTORYFLOW ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `server/.env` and adjust the variables for your deployment.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Database Connection (Prisma)
# Local SQLite (Default for zero-config quickstart):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql://factoryflow_user:secure_password@localhost:5432/factoryflow_db?schema=public"

# Authentication Security (JWT)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# AI Manufacturing Copilot (OpenAI API)
# Optional: If omitted, the AI Copilot operates using real authorized ERP database query tools
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Egyptian Manufacturing Localization
FACTORY_TIMEZONE=Africa/Cairo
DEFAULT_VAT_RATE=14.0
DEFAULT_WHT_RATE=1.0
DEFAULT_CURRENCY=EGP
DEFAULT_COUNTRY=EG
